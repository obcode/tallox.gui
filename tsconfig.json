{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	},
	// Paths, types and further options come from $app/tsconfig, which `svelte-kit sync` writes
	// into node_modules. The include list is ours since SvelteKit 3: the sources, the Playwright
	// specs, and the configuration files at the root.
	// This project is TypeScript-only; allowJs/checkJs are only there so that configuration
	// files such as eslint.config.js are checked as well.
	"include": ["src", "tests", "*"]
}
