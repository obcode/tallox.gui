# Nach .env kopieren. Enthält keine Secrets — nur, wo das Backend liegt.

# Vom Browser aus. In der Produktion die öffentliche URL.
PUBLIC_TALLOX_SERVER="http://localhost:8080/query"

# Vom SSR-Prozess aus (serverseitig, privat).
#
# In der Produktion zeigt das containerintern auf http://tallox-api:8080/query und umgeht damit
# den Auth-Proxy — deshalb muss die GUI das X-Remote-User selbst weiterreichen (siehe
# src/lib/server/backend.ts). NIEMALS auf die öffentliche URL zeigen lassen: der SSR-Prozess
# hat kein OIDC-Cookie und bekäme HTML vom IdP zurück.
TALLOX_SERVER="http://localhost:8080/query"

# Ein befristeter „Feedback"-Eintrag in der Navigationsleiste, oder leer für keinen.
#
# Die Adresse steht in der Umgebung und nicht im Code, und das hat zwei Gründe: dieses
# Repository ist öffentlich und der Raum, auf den sie zeigt, ist es nicht — und „befristet"
# heißt so eine Konfigurationsänderung statt eines Reverts. Ohne Wert erscheint kein Eintrag.
PUBLIC_TALLOX_FEEDBACK_URL=""
