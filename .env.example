# Copy to .env. Contains no secrets — only where the backend lives.

# From the browser. In production the public URL.
PUBLIC_TALLOX_SERVER="http://localhost:8080/query"

# From the SSR process (server-side, private).
#
# In production this points container-internally at http://tallox-api:8080/query and so
# bypasses the auth proxy — which is why the GUI has to pass on X-Remote-User itself (see
# src/lib/server/backend.ts). NEVER point it at the public URL: the SSR process has no
# OIDC cookie and would get HTML back from the IdP.
TALLOX_SERVER="http://localhost:8080/query"

# A temporary "Feedback" entry in the navigation bar, or empty for none.
#
# The address lives in the environment and not in the code, for two reasons: this
# repository is public and the room it points to is not — and "temporary" then means a
# configuration change rather than a revert. Without a value no entry appears.
PUBLIC_TALLOX_FEEDBACK_URL=""
